{
  "name": "documi",
  "version": "0.1.0",
  "private": true,
  "description": "Living Specification platform for AI-assisted engineering",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/naatin777/documi.git"
  },
  "bin": {
    "documi": "src/cli.ts"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "documi:check": "bun src/cli.ts check",
    "check": "bun check",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "verify": "mkdir -p .documi && bun test --reporter=junit --reporter-outfile=.documi/test-results.xml && bun run check && bun run lint && bun run format:check && bun run knip && bun run documi:check -- --no-review-edit"
  },
  "dependencies": {
    "@ast-grep/lang-go": "^0.0.6",
    "@ast-grep/lang-java": "^0.0.7",
    "@ast-grep/lang-kotlin": "^0.0.7",
    "@ast-grep/lang-python": "^0.0.6",
    "@ast-grep/lang-rust": "^0.0.7",
    "@ast-grep/lang-swift": "^0.0.8",
    "@ast-grep/napi": "^0.51.3",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "better-result": "^3.0.1",
    "diff": "^9.0.0",
    "fast-xml-parser": "^5.12.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.8.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/mdast": "^4.0.4",
    "knip": "^6.45.1",
    "mdast-util-mdx": "^3.0.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.3"
}
