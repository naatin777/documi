{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": false,
  "printWidth": 120,
  "trailingComma": "all",
  "sortImports": {
    "newlinesBetween": false
  },
  "sortPackageJson": true,
  "sortTailwindcss": {
    "stylesheet": "./src/web/styles.css"
  },
  "ignorePatterns": ["docs/**", "**/*.md", "**/*.mdx"]
}
