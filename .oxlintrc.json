{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "ignorePatterns": ["dist/**", "coverage/**", "docs/**"],
  "rules": {
    "import/no-cycle": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/switch-exhaustiveness-check": [
      "error",
      {
        "considerDefaultExhaustiveForUnions": true
      }
    ],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/set-state-in-effect": "error",
    "react/no-deriving-state-in-effects": "error",
    "react/no-danger": "error",
    "eslint/no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "react/react-in-jsx-scope": "off",
    "react/no-array-index-key": "off",
    "react/exhaustive-effect-dependencies": "off",
    "import/no-unassigned-import": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "eslint/no-await-in-loop": "off",
    "eslint/no-underscore-dangle": "off",
    "typescript/consistent-return": "off",
    "typescript/no-unsafe-type-assertion": "off"
  },
  "overrides": [
    {
      "files": ["src/core/**"],
      "rules": {
        "eslint/no-console": "error",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react/*",
                  "react-dom",
                  "react-dom/*",
                  "react-router",
                  "hono",
                  "hono/*",
                  "@hono/*",
                  "sigma",
                  "sigma/*",
                  "i18next",
                  "react-i18next",
                  "@base-ui/*",
                  "@tanstack/*",
                  "lucide-react",
                  "mermaid",
                  "shiki",
                  "shiki/*"
                ],
                "message": "src/core/ はフレームワーク非依存に保つ必要があります（AGENTS.md 不変ルール #2）。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/server/**"],
      "rules": {
        "eslint/no-console": "off",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../web/*", "../../web/*", "../web", "../../web"],
                "message": "src/server/ から src/web/ を参照しないでください。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/cli.ts"],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      "files": ["src/web/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../server/*", "../../server/*"],
                "allowTypeImports": true,
                "message": "src/web/ から src/server/ への参照は import type のみ許可されています。"
              },
              {
                "group": ["node:*", "bun", "bun:*"],
                "message": "src/web/（ブラウザ環境）で Node / Bun 組み込みモジュールを import しないでください。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/web/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useEffect"],
                "message": "UI コンポーネントでの生 useEffect は禁止です。状態同期はレンダー派生値やイベントハンドラで実装し、外部システム同期は src/web/hooks.ts または専用アダプタに隔離してください。"
              },
              {
                "name": "@base-ui/react/dialog",
                "message": "共通ラッパー（src/web/components/ui/Dialog.tsx）経由で利用してください。"
              },
              {
                "name": "@base-ui/react/tooltip",
                "message": "共通ラッパー（src/web/components/ui/Tooltip.tsx）経由で利用してください。"
              }
            ],
            "patterns": [
              {
                "group": ["../server/*", "../../server/*"],
                "allowTypeImports": true,
                "message": "src/web/ から src/server/ への参照は import type のみ許可されています。"
              },
              {
                "group": ["node:*", "bun", "bun:*"],
                "message": "src/web/（ブラウザ環境）で Node / Bun 組み込みモジュールを import しないでください。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/web/components/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useEffect"],
                "message": "共通 UI ラッパーでの生 useEffect は禁止です。"
              }
            ],
            "patterns": [
              {
                "group": ["../server/*", "../../server/*", "../../../server/*"],
                "allowTypeImports": true,
                "message": "src/web/ から src/server/ への参照は import type のみ許可されています。"
              },
              {
                "group": ["node:*", "bun", "bun:*"],
                "message": "src/web/（ブラウザ環境）で Node / Bun 組み込みモジュールを import しないでください。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/web/components/SigmaGraph.tsx",
        "src/web/components/MermaidBlock.tsx",
        "src/web/components/BundleLayout.tsx",
        "src/web/components/DocTabs.tsx",
        "src/web/components/DocPeekPane.tsx",
        "src/web/components/CodeExplorerLayout.tsx",
        "src/web/components/DocLayout.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@base-ui/react/dialog",
                "message": "共通ラッパー（src/web/components/ui/Dialog.tsx）経由で利用してください。"
              },
              {
                "name": "@base-ui/react/tooltip",
                "message": "共通ラッパー（src/web/components/ui/Tooltip.tsx）経由で利用してください。"
              }
            ],
            "patterns": [
              {
                "group": ["../server/*", "../../server/*"],
                "allowTypeImports": true,
                "message": "src/web/ から src/server/ への参照は import type のみ許可されています。"
              },
              {
                "group": ["node:*", "bun", "bun:*"],
                "message": "src/web/（ブラウザ環境）で Node / Bun 組み込みモジュールを import しないでください。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/web/mdast.tsx",
        "src/web/components/CodeBlock.tsx",
        "src/web/components/HighlightedCode.tsx",
        "src/web/components/MermaidBlock.tsx",
        "src/web/components/CodeExplorerLayout.tsx"
      ],
      "rules": {
        "react/no-danger": "off"
      }
    },
    {
      "files": ["tests/**"],
      "rules": {
        "typescript/await-thenable": "off",
        "eslint/no-console": "off"
      }
    }
  ]
}
